  "keyFeatures": [
    "Role-based access control with Student, Instructor, and Admin roles",
    "Course creation with public/private visibility and Razorpay payment integration",
    "Timed online exams with auto-grading and results delivery via email",
    "Student enrollment management with free and paid course support",
    "AI-powered chatbot using Google Gemini for student assistance",
    "JWT-based stateless authentication with email verification and password reset",
    "Admin dashboard with user management, analytics, and review moderation",
    "Full AWS deployment via Terraform (ECS Fargate, RDS, CloudFront, WAF)",
    "Multi-stage Docker builds and Docker Compose for local development",
    "GitHub Actions and optional Jenkins CI/CD pipeline with Terraform plan on PR"
  ],
